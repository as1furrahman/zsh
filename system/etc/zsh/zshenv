# /etc/zsh/zshenv: system-wide .zshenv file for zsh(1).
#
# This file is sourced on all invocations of the shell.
# If the -f flag is present or if the NO_RCS option is
# set within this file, all other initialization files
# are skipped.
#
# This file should contain commands to set the command
# search path, plus other important environment variables.
# This file should not contain commands that produce
# output or assume the shell is attached to a tty.
#
# Global Order: zshenv, zprofile, zshrc, zlogin

if [[ -z "$PATH" || "$PATH" == "/bin:/usr/bin" ]]
then
	export PATH="/usr/local/bin:/usr/bin:/bin:/usr/games"
fi

# ---------------------------------------------------------------------------
# Point zsh at ~/.config/zsh instead of $HOME (managed by the dotfile repo).
#
# This has to live in /etc/zsh/zshenv and not in the user's own .zshenv: this
# file is read *first*, so anything that changes $ZDOTDIR afterwards is too
# late to relocate the files being read. zsh resolves every startup file
# relative to $ZDOTDIR, so once this is set it reads
# $ZDOTDIR/.zshrc rather than ~/.zshrc, and ~/.zshrc stops being used.
#
# Everything above this line is the PATH guard from the stock Debian/Ubuntu
# /etc/zsh/zshenv, kept so the default PATH still applies. Other distros ship
# no such file, so this simply becomes the system zshenv. If your package
# manager reports a local modification on a zsh upgrade, keep this version.
# ---------------------------------------------------------------------------

if [[ -z "$XDG_CONFIG_HOME" ]]
then
    export XDG_CONFIG_HOME="$HOME/.config"
fi

if [[ -d "$XDG_CONFIG_HOME/zsh" ]]
then
    export GHOSTTY_ZSH_ZDOTDIR="$XDG_CONFIG_HOME/zsh"
    # Supply a default only: any nonempty $ZDOTDIR is left alone. Ghostty points
    # $ZDOTDIR at its transient integration directory and uses
    # $GHOSTTY_ZSH_ZDOTDIR (set just above) to reach the real config, so it keeps
    # working either way. The previous `!= *ghostty*` test did not add anything --
    # an empty value already satisfies it -- and it silently overrode any
    # ZDOTDIR the user had set deliberately.
    if [[ -z "$ZDOTDIR" ]]
    then
        export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
    fi
fi
